# ── TaskBoard .gitignore ──────────────────────────────────────────────────────

# ── Environment and secrets ───────────────────────────────────────────────────
.env
.env.*
!.env.example      # keep the example template
*.pem
*.key
secrets/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-wheel-metadata/
.venv/
venv/
ENV/
env/

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.nox/
nosetests.xml

# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
frontend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js
.eslintcache

# ── Docker ────────────────────────────────────────────────────────────────────
# Do not commit override files that contain credentials
docker-compose.override.yml

# ── Terraform ─────────────────────────────────────────────────────────────────
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/terraform.tfstate
terraform/terraform.tfstate.backup
terraform/*.tfvars
!terraform/*.tfvars.example
terraform/crash.log

# ── Kubernetes / Helm ─────────────────────────────────────────────────────────
# Do not commit generated secret manifests
*.secret.yaml
kubeconfig

# ── AWS ───────────────────────────────────────────────────────────────────────
.aws/

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.suo
*.user

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Alembic ───────────────────────────────────────────────────────────────────
# Never exclude alembic/versions – they are required source files
