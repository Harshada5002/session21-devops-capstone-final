# .gitattributes – normalize line endings across Windows/Linux/macOS
* text=auto eol=lf

# Force LF for these file types even on Windows
*.py    text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.sh    text eol=lf
*.tf    text eol=lf
*.tpl   text eol=lf
*.ini   text eol=lf
*.txt   text eol=lf
*.conf  text eol=lf
*.mako  text eol=lf

# Binary files – no line ending conversion
*.png   binary
*.jpg   binary
*.ico   binary
*.svg   text eol=lf
